<!--
    Input:
        device/samsung/universal9830-common/manifest.xml
        device/samsung/universal9830-common/hubble/manifest.xml
        recovery/root/vendor/etc/vintf/manifest.xml
        + keymaster/gatekeeper fixes for recovery (mdfpp + strongbox instances)
-->
<manifest version="2.0" type="device" target-level="6">
