#
# vendor.prop for x1s
#

# Device
ro.display.series=Samsung Galaxy S20 
ro.product.board=exynos990
ro.board.platform=universal990

# Crypto & Encryption
ro.crypto.allow_encrypt_override=true
ro.crypto.metadata_init_delete_all_keys.enabled=false
ro.crypto.volume.metadata.method=dm-default-key
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.options=::v2
ro.security.keystore.keytype=sakv2,gak,sgak
ro.hardware.keystore=mdfpp
ro.hardware.gatekeeper=mdfpp
ro.hardware.keystore.desede=true
vendor.gatekeeper.disable_spu=true
ro.crypto.volume.filenames_mode=aes-256-cts

# USB Configuration
persist.sys.usb.config=mtp
sys.usb.controller=10e00000.dwc3
vendor.usb.use_ffs_mtp=1

# Partition
ro.boot.dynamic_partitions=true

# Display
ro.sf.lcd_density=640

# Haptics (Vibrations)
ro.vibrator.state=1

# AVB
ro.boot.vbmeta.avb_version=1.0
ro.boot.avb_version=1.0

# Forçar o TWRP a carregar a interface mesmo se o Keymaster demorar
twrp.crypto_ready=1

# Evita que o Keystore 2.0 trave o processo de boot do recovery
ro.hardware.keystore_desede=false
ro.hardware.strongbox_keystore=false

# Se o seu Android for 11 ou superior, o Gatekeeper pode precisar disso
vendor.gatekeeper.disable_on_with_no_password=1
persist.sys.keymaster_v3_0.remote=0

# Desativa a espera pelo Keymaster no início
ro.crypto.state=unencrypted
ro.crypto.fs_crypto_blkdev=/dev/block/by-name/userdata